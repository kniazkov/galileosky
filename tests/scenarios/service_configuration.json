{
  "name": "Конфигурация, диагностика, журнал и watchdog",
  "steps": [
    {
      "send": {"id": 1, "command": "tick", "timestamp_ms": 0},
      "expect": [
        {
          "id": 1,
          "type": "state",
          "full": false,
          "state": {"timestamp_ms": 0, "revision": 1}
        },
        {"id": 1, "type": "done"}
      ]
    },
    {
      "send": {"id": 2, "command": "service_rx", "service_data": [1]},
      "expect": [
        {
          "id": 2,
          "type": "service_tx",
          "data": [129, 0, 1, 232, 3, 0, 0]
        },
        {"id": 2, "type": "done"}
      ]
    },
    {
      "send": {
        "id": 3,
        "command": "service_rx",
        "service_data": [2, 0, 244, 1, 0, 0]
      },
      "expect": [
        {"id": 3, "type": "service_tx", "data": [130, 0]},
        {"id": 3, "type": "done"}
      ]
    },
    {
      "send": {"id": 4, "command": "service_rx", "service_data": [1]},
