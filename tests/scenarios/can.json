{
  "name": "CAN и параметры автомобиля OBD-II",
  "steps": [
    {
      "send": {"id": 1, "command": "tick", "timestamp_ms": 0},
      "expect": [
        {
          "id": 1,
          "type": "state",
          "full": false,
          "state": {"timestamp_ms": 0, "revision": 1}
        },
        {"id": 1, "type": "done"}
      ]
    },
    {
      "send": {"id": 2, "command": "advance", "milliseconds": 1000},
      "expect": [
        {
          "id": 2,
          "type": "state",
          "full": false,
          "state": {"timestamp_ms": 1000, "revision": 2}
        },
        {
          "id": 2,
          "type": "can_tx",
          "can_id": 2015,
          "data": [2, 1, 12, 0, 0, 0, 0, 0]
        },
        {
          "id": 2,
          "type": "can_tx",
          "can_id": 2015,
          "data": [2, 1, 13, 0, 0, 0, 0, 0]
        },
        {
          "id": 2,
          "type": "can_tx",
          "can_id": 2015,
          "data": [2, 1, 5, 0, 0, 0, 0, 0]
        },
        {
          "id": 2,
          "type": "can_tx",
          "can_id": 2015,
          "data": [2, 1, 47, 0, 0, 0, 0, 0]
        },
        {
          "id": 2,
          "type": "can_tx",
